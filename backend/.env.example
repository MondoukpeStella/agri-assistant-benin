# Required. Accepted values: development, test, production.
APP_ENV=development

# Optional. Accepted values: DEBUG, INFO, WARNING, ERROR. Default: INFO.
LOG_LEVEL=INFO

# Optional. Comma-separated explicit origins. Leave empty to disable CORS.
# The value * is rejected.
CORS_ORIGINS=

# Optional. off or qwen. qwen loads Qwen2.5-0.5B-Instruct locally and only
# extracts the product and the market. It never supplies a price.
# Install transformers yourself; it is not part of the locked dependencies.
FRENCH_LLM=off
